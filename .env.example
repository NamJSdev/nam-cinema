# ==============================================================================
# NAM CINEMA — Environment Configuration Template
# Copy this file to `nam_cinema/backend/.env` or `nam_cinema/.env` and replace
# placeholder values with your own secrets. Never commit `.env` to version control!
# ==============================================================================

# Application Settings
APP_NAME="Nam Cinema API"
APP_ENV="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000
PUBLIC_BASE_URL="http://localhost:8000"

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://10.0.2.2:8000"

# Database Configuration (PostgreSQL recommended for production/Docker)
# For local development without Docker/PostgreSQL installed, you may use:
# DATABASE_URL="sqlite+aiosqlite:///./nam_cinema_dev.db"
DATABASE_URL="postgresql+asyncpg://namcinema:namcinema_secret@localhost:5432/namcinema"

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"
REDIS_ENABLED=true
METADATA_CACHE_TTL_SECONDS=900

# Security & JWT Configuration
# Generate a strong key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY="CHANGE_ME_WITH_A_CRYPTOGRAPHICALLY_RANDOM_64_BYTE_SECRET_KEY"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PLAYBACK_SIGNING_SECRET="CHANGE_ME_WITH_ANOTHER_RANDOM_SIGNING_SECRET_FOR_HLS_SESSIONS"
PLAYBACK_SESSION_TTL_MINUTES=240

# Rate Limiting
LOGIN_RATE_LIMIT_REQUESTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# TMDB API Configuration (Get your key at https://www.themoviedb.org/settings/api)
# Never embed these credentials in the Flutter mobile bundle!
TMDB_API_KEY=""
TMDB_READ_ACCESS_TOKEN=""
TMDB_BASE_URL="https://api.themoviedb.org/3"
TMDB_IMAGE_BASE_URL="https://image.tmdb.org/t/p"
DEFAULT_LANGUAGE="vi-VN"
DEFAULT_REGION="VN"

# VSMOV Primary Catalog Provider Configuration
VSMOV_BASE_URL="https://vsmov.com/api"
VSMOV_TIMEOUT_SECONDS=12.0
VSMOV_CACHE_TTL_SECONDS=600

